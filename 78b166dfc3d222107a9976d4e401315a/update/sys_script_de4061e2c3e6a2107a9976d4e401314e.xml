        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	var insgr=new GlideRecord("u_insurance");
	insgr.query();
	while(insgr.next()){
		var edet=insgr.u_coverage_details.toString().split(',');
		if(edet.indexof(current.sys_id.toString())===-1)
		{
			edet.push(current.sys_id.toString());
			insgr.u_coverage_details=edet.join(',');
			insgr.update();
			gs.addInfoMessage("Policy added to all insurance");
		}
	}

})(current, previous);]]></script>

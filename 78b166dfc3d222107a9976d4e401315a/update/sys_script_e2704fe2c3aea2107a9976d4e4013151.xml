	if(current.u_assigned_to != previous.u_assigned_to){
		var ward = new GlideRecord('u_ward')
		var wardID = current.u_ward_id
		ward.addQuery('sys_id', wardID)
		ward.query()
		if(ward.next()){
			ward.u_occupancy += 1
			ward.update()
			gs.addInfoMessage('occupancy updated...')
		}
	}

})(current, previous);]]></script>

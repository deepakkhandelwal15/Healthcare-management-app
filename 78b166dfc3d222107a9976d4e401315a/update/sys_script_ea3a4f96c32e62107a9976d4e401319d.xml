        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {

	if(current.operation()=== "insert"   ||  current.u_dosage.changes()  ||   current.u_frequency.changes()){
          var freq;
		  if(current.u_frequency == "once daily"){
			freq=1;
		  }

		  else if(current.u_frequency== "twice daily"){
			freq=2;
		  }
		  else if(current.u_frequency== "twice daily"){
			freq=3;
		  }
		  var dosage = parseFloat(current.u_dosage);
		  current.u_total_dosage =freq* dosage;
	}

})(current, previous);]]></script>
